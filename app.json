{
  "expo": {
    "name": "Foto Owl",
    "slug": "foto-owl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foto-owl",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.saitarunallu.fotoowl"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router", "expo-media-library"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
